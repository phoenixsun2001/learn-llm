# ============================================
# Learn-LLM Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# --- Required: Supabase (Auth + Database) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Required: Admin Dashboard Login ---
ADMIN_TOKEN=learn-llm-admin

# --- Optional: AI Pipeline Processing ---
# Claude API (for content summarization and classification)
ANTHROPIC_API_KEY=

# Ollama local LLM (fallback if no Claude API key)
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: Pipeline Output ---
# Materials output directory (mounted as volume in Docker)
PIPELINE_OUTPUT_DIR=/app/content/materials/
